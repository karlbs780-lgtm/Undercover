# Joueur IA (variante « imposteur IA ») — Google Gemini
# Cle GRATUITE : https://aistudio.google.com  ->  « Get API key » (sans carte).
#
# Local  : copie ce fichier en .env n'est PAS lu automatiquement par le serveur.
#          Lance plutot avec la variable en ligne, ex :
#            bash        ->  GEMINI_API_KEY=xxxx npm start
#            PowerShell  ->  $env:GEMINI_API_KEY="xxxx"; npm start
# Render : Settings > Environment > Add  ->  GEMINI_API_KEY = ta cle
#
# Sans cle, le jeu fonctionne quand meme : l'IA joue en mode secours (indices
# et votes basiques). Avec la cle, elle devient crediblement humaine.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
